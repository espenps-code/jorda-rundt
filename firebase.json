{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "*.log"],
      "predeploy": ["npm --prefix functions run kopier"]
    }
  ],
  "database": { "rules": "database.rules.json" },
  "emulators": {
    "database": { "port": 9000 },
    "functions": { "port": 5001 },
    "auth": { "port": 9099 },
    "ui": { "enabled": false }
  }
}
